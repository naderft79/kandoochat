{
  "id": "/",
  "name": "کندو | همسریابی",
  "short_name": "کندو",
  "description": "کندو، جایی برای پیدا کردن نیمه گمشده شما",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "dir": "rtl",
  "lang": "fa",
  "categories": ["social", "lifestyle"],
  "handle_links": "preferred",
  "launch_handler": { "client_mode": "focus-existing" },
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://kandoochat.top/manifest.json"
    }
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "گفتگوها",
      "short_name": "چت",
      "url": "/dashboard/chat",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "جستجوی کاربران",
      "short_name": "جستجو",
      "url": "/dashboard/search",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "کیف پول",
      "short_name": "کیف پول",
      "url": "/dashboard/coins",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/mobile.png",
      "sizes": "1080x2400",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "کندو — همسریابی"
    },
    {
      "src": "/screenshots/desktop.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "کندو — همسریابی"
    }
  ]
}
