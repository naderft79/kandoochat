<?xml version="1.0" encoding="utf-8" ?>
<!-- فلیور اپ مدیریت: حذف مجوزها و سرویس هایی که پنل به آن ها نیاز ندارد -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- پنل مدیریت به دوربین و میکروفون نیاز ندارد -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />

    <application>
        <!-- چرخش آزاد — قفل عمودی مانیفست اصلی برداشته می شود -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="unspecified"
            tools:replace="android:screenOrientation" />

        <!-- اپ مدیریت بدون FCM — سرویس و متادیتای پوش حذف می شود -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            tools:node="remove" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            tools:node="remove" />
    </application>
</manifest>
