{
  "name": "kandoo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "concurrently \"next dev --turbopack\" \"cd D:\\KandooPay && npm run dev\"",
    "dev:kandoo": "next dev --turbopack",
    "dev:pay": "cd D:\\KandooPay && npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "icons": "tsx scripts/generate-icons.ts",
    "build:pwa": "tsx scripts/generate-icons.ts && tsx scripts/generate-screenshots.ts && next build",
    "build:apk": "tsx scripts/build-apk.ts",
    "deploy:apk": "tsx scripts/deploy-apk.ts",
    "cap:sync": "npx cap sync android",
    "db:seed-missions": "tsx prisma/seed-missions.ts",
    "db:seed-production": "tsx prisma/seed-production.ts",
    "lint:ui": "tsx scripts/check-ui.ts --strict",
    "lint:ui:report": "tsx scripts/check-ui.ts",
    "e2e:seed": "tsx scripts/seed-e2e.ts",
    "e2e:clean": "tsx scripts/seed-e2e.ts --clean",
    "test:ui": "playwright test",
    "test:ui:mobile": "playwright test --project=iphone-se --project=iphone-14 --project=pixel-7",
    "test:ui:desktop": "playwright test --project=laptop-1366 --project=desktop-1920",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:perf": "lhci autorun",
    "geoip:download": "tsx scripts/download-geoip.ts"
  },
