    "next": "16.4.0",
    "next-themes": "0.4.6",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-easy-crop": "^6.2.3",
    "react-icons": "^5.7.0",
    "react-image-crop": "^11.1.2",
    "web-push": "3.6.7",
    "write-excel-file": "4.1.1",
