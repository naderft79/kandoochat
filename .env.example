# === دیتابیس ===
DATABASE_URL="postgresql://user:password@localhost:5432/kandoo"

# === احراز ===
JWT_SECRET="یک رشته تصادفی طولانی"

# === دامنه سایت — تنها جایی که دامنه تعریف می شود ===
# با تغییر دامنه فقط این مقدار را عوض کنید؛ همه بخش ها (متاتگ، sitemap، robots، callback پرداخت، اپ اندروید) دنبالش می آیند
NEXT_PUBLIC_SITE_URL="https://kandoochat.top"

# === Web Push (PWA) ===
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@kandoochat.top"

# === FCM اندروید — JSON سرویس اکانت فایربیس به صورت یک خط ===
# بدون این مقدار پوش نوتیفیکیشن اپ غیرفعال می ماند (بقیه برنامه کار می کند)
FCM_SERVICE_ACCOUNT=""
# فقط وقتی true شود که google-services.json در android/app موجود باشد
NEXT_PUBLIC_FCM_ENABLED=""

# === پرداخت ===
KANDOOPAY_URL=""
KANDOO_PUBLIC_URL=""
KANDOOPAY_SHARED_SECRET=""

# === پیامک ===
# کد تایید از طریق KandooPay (KANDOOPAY_URL + KANDOOPAY_SHARED_SECRET) ارسال می شود.
# کلید صبانوین (SABANOVIN_API_KEY) فقط در .env کندوپی است.

# === تشخیص چهره ===
FACE_DETECTOR_URL=""
# توکن مشترک با سرویس چهره (حداقل ۳۲ کاراکتر)
FACE_SERVICE_TOKEN=""

# === توسعه ===
# در توسعه کد پیامک را در پاسخ برمی گرداند — در production حتما false
OTP_DEV_ECHO="false"

# نمک هش روزانه بازدیدکننده برای آمار بازدید (اختیاری؛ در نبود آن از JWT_SECRET استفاده می شود)
ANALYTICS_SALT=

# مسیر دیتابیس کشور DB-IP Lite (اختیاری؛ پیش فرض data/geo/dbip-country-lite.mmdb)
GEOIP_DB_PATH=
